# ==============================================================================
# Root .gitignore for Industrial Waste Exchange Platform
# Covers root, backend (Node.js/Express), and frontend (React)
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment and Credentials (CRITICAL: Never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
frontend/.env
!*.env.example

# Production Builds
build/
frontend/build/
dist/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
frontend/coverage/
.nyc_output/

# Editor & IDE Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files & backups
*.tmp
*.bak
*.swp
.git-backup/
frontend/.git-backup/
